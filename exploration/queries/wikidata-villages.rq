PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX schema: <http://schema.org/>
PREFIX hint: <http://www.bigdata.com/queryHints#>

# Finds Wikidata items whose label or alias equals one of the backbone village names, plus all
# submerged settlements (Q20616831) in the Netherlands, to catch villages spelled differently.
# The NAMES placeholder in VALUES is replaced by the script with language-tagged literals,
# e.g. "Valkenisse"@nl "Valkenisse"@mul.
# The UNION branches keep each property independent, so they don't multiply into a cross product.
CONSTRUCT {
  ?item rdfs:label ?label ;
    skos:altLabel ?alt ;
    wdt:P31 ?class ;
    wdt:P17 ?country ;
    wdt:P131 ?adminArea ;
    wdt:P625 ?coord ;
    wdt:P571 ?inception ;
    wdt:P576 ?dissolved ;
    wdt:P359 ?rijksmonument ;
    wdt:P373 ?commonsCategory ;
    wdt:P18 ?image .
  ?class rdfs:label ?classLabel .
  ?adminArea rdfs:label ?adminAreaLabel .
  ?article schema:about ?item ;
    schema:isPartOf <https://nl.wikipedia.org/> ;
    schema:name ?articleName .
}
WHERE {
  # Resolve the matching items first and keep that order (a Blazegraph query hint): otherwise the
  # endpoint evaluates UNION branches such as ?item wdt:P31 ?class over all of Wikidata and times out.
  hint:Query hint:optimizer "None" .
  {
    SELECT DISTINCT ?item WHERE {
      {
        VALUES ?name { {{NAMES}} }
        { ?item rdfs:label ?name } UNION { ?item skos:altLabel ?name }
      } UNION {
        ?item wdt:P31 wd:Q20616831 ;
          wdt:P17 wd:Q55 .
      }
    }
  }
  {
    ?item rdfs:label ?label .
    FILTER(LANG(?label) IN ("nl", "en", "mul"))
  } UNION {
    ?item skos:altLabel ?alt .
    FILTER(LANG(?alt) IN ("nl", "en", "mul"))
  } UNION {
    ?item wdt:P31 ?class .
    OPTIONAL { ?class rdfs:label ?classLabel . FILTER(LANG(?classLabel) = "nl") }
  } UNION {
    ?item wdt:P17 ?country .
  } UNION {
    ?item wdt:P131 ?adminArea .
    OPTIONAL { ?adminArea rdfs:label ?adminAreaLabel . FILTER(LANG(?adminAreaLabel) = "nl") }
  } UNION {
    ?item wdt:P625 ?coord .
  } UNION {
    ?item wdt:P571 ?inception .
  } UNION {
    ?item wdt:P576 ?dissolved .
  } UNION {
    ?item wdt:P359 ?rijksmonument .
  } UNION {
    ?item wdt:P373 ?commonsCategory .
  } UNION {
    ?item wdt:P18 ?image .
  } UNION {
    ?article schema:about ?item ;
      schema:isPartOf <https://nl.wikipedia.org/> ;
      schema:name ?articleName .
  }
}
