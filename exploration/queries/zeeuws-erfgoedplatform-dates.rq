PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>

# Production periods of the selected museum objects. Only about 14% of the objects have one.
# The dataset uses 0001-01-01 for an unknown date (in 422 end dates and in every schema:datePublished,
# which is therefore not used); the script treats year 1 as unknown.
# The OBJECTS placeholder is replaced by the script with the object IRIs.
SELECT ?object ?begin ?end WHERE {
  VALUES ?object { {{OBJECTS}} }
  ?object crm:P108i_was_produced_by/crm:P4_has_time-span ?timeSpan .
  OPTIONAL { ?timeSpan crm:P82a_begin_of_the_begin ?begin }
  OPTIONAL { ?timeSpan crm:P82b_end_of_the_end ?end }
}
