PREFIX edm: <http://www.europeana.eu/schemas/edm/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>

# Full descriptions of the selected objects: their own triples, the labels, types and coordinates of
# the thesaurus terms they refer to (places, events, concepts, people), and their aggregation (image
# and licence).
# The OBJECTS placeholder is replaced by the script with the object IRIs.
CONSTRUCT {
  ?object ?p ?o .
  ?o a ?termType ;
    skos:prefLabel ?label ;
    wgs84_pos:lat ?lat ;
    wgs84_pos:long ?long .
  ?aggregation ?ap ?ao .
}
WHERE {
  VALUES ?object { {{OBJECTS}} }
  {
    ?object ?p ?o .
    OPTIONAL { ?o a ?termType ; skos:prefLabel ?label }
    OPTIONAL { ?o wgs84_pos:lat ?lat ; wgs84_pos:long ?long }
  } UNION {
    ?aggregation edm:aggregatedCHO ?object ;
      ?ap ?ao .
  }
}
