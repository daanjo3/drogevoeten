PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# Labels and aliases of Wikidata items, from the local output of 02-wikidata-villages
# (data/wikidata/villages.ttl). Used as extra spellings of the matched villages.
# The ITEMS placeholder is replaced by the script with the item IRIs.
SELECT ?item ?label WHERE {
  VALUES ?item { {{ITEMS}} }
  { ?item rdfs:label ?label } UNION { ?item skos:altLabel ?label }
}
