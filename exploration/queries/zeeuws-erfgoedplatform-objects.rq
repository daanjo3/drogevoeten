PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Full descriptions of the selected museum objects: their own triples, the blank nodes they point
# to (identifiers, materials, dimensions, production, images) two levels deep, and the labels of
# the types and places those refer to.
# The OBJECTS placeholder is replaced by the script with the object IRIs.
CONSTRUCT {
  ?object ?p ?o .
  ?o ?p2 ?o2 .
  ?o2 ?p3 ?o3 .
}
WHERE {
  VALUES ?object { {{OBJECTS}} }
  ?object ?p ?o .
  OPTIONAL {
    ?o ?p2 ?o2 .
    FILTER(isBlank(?o) || ?p2 = rdfs:label)
    OPTIONAL {
      ?o2 ?p3 ?o3 .
      FILTER(isBlank(?o2) || ?p3 = rdfs:label)
    }
  }
}
