PREFIX ceo: <https://linkeddata.cultureelerfgoed.nl/def/ceo#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>

# Geometries (WKT in WGS84) of RCE records in the Zeeland subset. A record can have several.
# The CLASSES placeholder is replaced by the script.
SELECT ?record ?wkt WHERE {
  VALUES ?class { {{CLASSES}} }
  ?record a ?class ;
    ceo:heeftGeometrie/geo:asWKT ?wkt .
}
