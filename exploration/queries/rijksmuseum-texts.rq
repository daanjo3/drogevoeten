PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX edm: <http://www.europeana.eu/schemas/edm/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#>

# All texts of the objects in the Rijksmuseum subset: titles, descriptions, and the labels of the
# thesaurus terms they refer to. dc:subject holds what an object depicts (places, events, concepts),
# dct:spatial where it was made, dct:temporal the event it shows. Places come with their coordinates
# when the thesaurus has them. The subset is already filtered on names and drowning, so the script
# needs every text of an object to decide on context.
SELECT ?object ?field ?text ?term ?lat ?long WHERE {
  ?object a edm:ProvidedCHO .
  {
    ?object dc:title ?text .
    BIND("title" AS ?field)
  } UNION {
    ?object dc:description ?text .
    BIND("description" AS ?field)
  } UNION {
    ?object dc:subject ?term .
    ?term a edm:Place ;
      skos:prefLabel ?text .
    OPTIONAL { ?term wgs84_pos:lat ?lat ; wgs84_pos:long ?long }
    BIND("depictedPlace" AS ?field)
  } UNION {
    ?object dct:spatial ?term .
    ?term a edm:Place ;
      skos:prefLabel ?text .
    OPTIONAL { ?term wgs84_pos:lat ?lat ; wgs84_pos:long ?long }
    BIND("productionPlace" AS ?field)
  } UNION {
    ?object dc:subject|dct:temporal ?term .
    ?term a edm:TimeSpan ;
      skos:prefLabel ?text .
    BIND("event" AS ?field)
  } UNION {
    ?object dc:subject ?term .
    ?term a skos:Concept ;
      skos:prefLabel ?text .
    BIND("subject" AS ?field)
  }
}
