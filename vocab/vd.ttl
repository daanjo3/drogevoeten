@prefix vd: <https://github.com/daanjo3/verdronkendorpen/vocab#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# The project vocabulary: terms for the drowned villages and for the results of matching them
# against other sources, where existing vocabularies have no fitting term. Every vd: term used in
# the data must be defined here; the scripts check this before writing matches.ttl and combined.ttl.
# The matching procedure behind these terms is described in docs/exploration-sop.md.
# TODO: the namespace is a placeholder; choose a permanent base before publishing.

vd: a owl:Ontology ;
  dcterms:title "Verdronken dorpen vocabulary"@en , "Vocabulaire verdronken dorpen"@nl ;
  dcterms:description "Terms for the drowned villages of Zeeland and for linking them to records in other sources."@en ;
  vann:preferredNamespacePrefix "vd" ;
  vann:preferredNamespaceUri "https://github.com/daanjo3/verdronkendorpen/vocab#" .

#################################################################
# Classes
#################################################################

vd:Village a owl:Class ;
  rdfs:subClassOf schema:Place ;
  rdfs:label "Village"@en , "Verdronken dorp"@nl ;
  rdfs:comment "A village from the backbone, the Kaart Verdronken Dorpen Zeeland. A village with several known locations has one vd:Village per location (\"Agger 1\", \"Agger 2\")."@en .

vd:WikipediaListRow a owl:Class ;
  rdfs:label "Wikipedia list row"@en ;
  rdfs:comment "A row of the table \"Tabel bij de kaart\" in the Dutch Wikipedia article \"Lijst van verdronken dorpen in Zeeland\"."@en .

vd:Candidate a owl:Class ;
  rdfs:label "Candidate"@en ;
  rdfs:comment "A possible link between a backbone village (vd:village) and a record in a source (vd:record), with how it was found and its status. A candidate with vd:key-generic has no village."@en .

#################################################################
# Village properties
#################################################################

vd:municipality a owl:DatatypeProperty ;
  rdfs:label "municipality"@en ;
  rdfs:comment "The present-day municipality the village lies in, as text from the backbone."@en ;
  rdfs:domain vd:Village ;
  rdfs:range xsd:string .

vd:drownedBeginYear a owl:DatatypeProperty ;
  rdfs:label "drowned, begin year"@en ;
  rdfs:comment "The first year of the period in which the village drowned. When the source names several dates, this is the last one; a century counts as its first to its last year (\"16e eeuw\" is 1500 to 1599)."@en ;
  schema:domainIncludes vd:Village , vd:WikipediaListRow ;
  rdfs:range xsd:integer .

vd:drownedEndYear a owl:DatatypeProperty ;
  rdfs:label "drowned, end year"@en ;
  rdfs:comment "The last year of the period in which the village drowned (see vd:drownedBeginYear). Equal to the begin year for a single year."@en ;
  schema:domainIncludes vd:Village , vd:WikipediaListRow ;
  rdfs:range xsd:integer .

vd:drownedNote a owl:DatatypeProperty ;
  rdfs:label "drowned, as written"@en ;
  rdfs:comment "The text the dates of drowning were taken from, as written in the source (\"1530/1532\", \"stormvloed en militaire inundatie 1488, inundatie 1586\")."@en ;
  schema:domainIncludes vd:Village , vd:WikipediaListRow ;
  rdfs:range rdf:langString .

vd:drowningCause a owl:ObjectProperty ;
  rdfs:label "cause of drowning"@en ;
  rdfs:comment "A cause of drowning that the source mentions, from vd:DrowningCauses."@en ;
  schema:domainIncludes vd:Village , vd:WikipediaListRow ;
  rdfs:range skos:Concept .

vd:wikipediaArticle a owl:ObjectProperty ;
  rdfs:subPropertyOf rdfs:seeAlso ;
  rdfs:label "Wikipedia article"@en ;
  rdfs:comment "The Wikipedia article linked from the village's row in the Wikipedia list. It can describe a successor of the drowned village, such as present-day Kortgene for \"'Oud'-Kortgene\"."@en ;
  schema:domainIncludes vd:Village , vd:WikipediaListRow .

vd:rowNumber a owl:DatatypeProperty ;
  rdfs:label "row number"@en ;
  rdfs:comment "The number (\"Nr\") of a row in the Wikipedia list, which is also its number on the map in the article."@en ;
  rdfs:domain vd:WikipediaListRow ;
  rdfs:range xsd:integer .

vd:matchStatus a owl:ObjectProperty ;
  rdfs:label "match status"@en ;
  rdfs:comment "The overall result of matching a village against a source that has at most one record per village, such as Wikidata, from vd:VillageStatuses. Only meaningful within that source's matches.ttl."@en ;
  rdfs:domain vd:Village ;
  rdfs:range skos:Concept .

#################################################################
# Candidate properties
#################################################################

vd:village a owl:ObjectProperty ;
  rdfs:label "village"@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range vd:Village .

vd:record a owl:ObjectProperty ;
  rdfs:label "record"@en ;
  rdfs:comment "The record in the source: a Wikidata item, a museum object, a row of the Wikipedia list."@en ;
  rdfs:domain vd:Candidate .

vd:source a owl:ObjectProperty ;
  rdfs:label "source"@en ;
  rdfs:comment "The dataset or page the record comes from."@en ;
  rdfs:domain vd:Candidate .

vd:matchedBy a owl:ObjectProperty ;
  rdfs:label "matched by"@en ;
  rdfs:comment "The match key that linked the record to the village, from vd:MatchKeys."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range skos:Concept .

vd:nameOrigin a owl:ObjectProperty ;
  rdfs:label "name origin"@en ;
  rdfs:comment "Where the name that matched comes from, from vd:NameOrigins. The strongest origin when several names matched."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range skos:Concept .

vd:matchedName a owl:DatatypeProperty ;
  rdfs:label "matched name"@en ;
  rdfs:comment "A village name that occurs in the record."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:string .

vd:matchedField a owl:DatatypeProperty ;
  rdfs:label "matched field"@en ;
  rdfs:comment "A field of the record in which a name was found, such as \"title\" or \"description\"."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:string .

vd:status a owl:ObjectProperty ;
  rdfs:label "status"@en ;
  rdfs:comment "Accepted, review or rejected, from vd:Statuses. Generic candidates have no status."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range skos:Concept .

vd:statusReason a owl:ObjectProperty ;
  rdfs:label "status reason"@en ;
  rdfs:comment "Why the candidate needs review or was rejected, or vd:reason-override when a manual decision set its status, from vd:StatusReasons."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range skos:Concept .

vd:overrideNote a owl:DatatypeProperty ;
  rdfs:label "override note"@en ;
  rdfs:comment "The reason given for a manual decision in exploration/resources/match-overrides.json."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:string .

vd:distanceKm a owl:DatatypeProperty ;
  rdfs:label "distance (km)"@en ;
  rdfs:comment "The distance in kilometres between the record's coordinates and the backbone point."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:decimal .

vd:classRank a owl:DatatypeProperty ;
  rdfs:label "class rank"@en ;
  rdfs:comment "How well the record's class fits a drowned village: 0 submerged settlement, 1 former settlement or ghost town, 2 human settlement, 3 other."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:integer .

vd:editDistance a owl:DatatypeProperty ;
  rdfs:label "edit distance"@en ;
  rdfs:comment "For a match on a near spelling: the edit distance between the spelling keys of the two names. Absent for an exact match."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range xsd:integer .

vd:suggestedVillage a owl:ObjectProperty ;
  rdfs:label "suggested village"@en ;
  rdfs:comment "For a generic candidate: a village whose name is spelled almost like a word in the record."@en ;
  rdfs:domain vd:Candidate ;
  rdfs:range vd:Village .

#################################################################
# Match keys, from strong to weak
#################################################################

vd:MatchKeys a skos:ConceptScheme ;
  skos:prefLabel "Match keys"@en ;
  skos:definition "How a record was linked to a village, ordered from strong (1) to weak (7) with skos:notation."@en .

vd:key-identifier a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "1" ;
  skos:prefLabel "identifier"@en ;
  skos:definition "A shared identifier, such as a Wikidata QID."@en .

vd:key-place-geo a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "2" ;
  skos:prefLabel "place with coordinates"@en ;
  skos:definition "A village name in a structured place field or label, with coordinates within the distance threshold of the backbone point."@en .

vd:key-place-name a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "3" ;
  skos:prefLabel "place name"@en ;
  skos:definition "A village name in a structured place field or label, without usable coordinates."@en .

vd:key-location a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "4" ;
  skos:prefLabel "location only"@en ;
  skos:definition "Coordinates close to the backbone point, without a matching name. Never accepted automatically."@en .

vd:key-text-context a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "5" ;
  skos:prefLabel "name in text, with context"@en ;
  skos:definition "A village name in free text, with words about drowning in the same record."@en .

vd:key-text-name a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "6" ;
  skos:prefLabel "name in text"@en ;
  skos:definition "A village name in free text, without further evidence."@en .

vd:key-generic a skos:Concept ;
  skos:inScheme vd:MatchKeys ;
  skos:notation "7" ;
  skos:prefLabel "generic"@en ;
  skos:definition "The record is about drowning, but names no village from the name index."@en .

#################################################################
# Name origins
#################################################################

vd:NameOrigins a skos:ConceptScheme ;
  skos:prefLabel "Name origins"@en ;
  skos:definition "Where a name in the name index comes from, which determines how much a match on it proves."@en .

vd:origin-primary a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "backbone name"@en .

vd:origin-numberless a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "backbone name without number"@en ;
  skos:definition "The backbone name without the number of one of several locations (\"Agger\" for \"Agger 1\")."@en .

vd:origin-wikipedia a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "Wikipedia list name"@en ;
  skos:definition "The name in the village's row of the Wikipedia list."@en .

vd:origin-wikidata a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "Wikidata label"@en ;
  skos:definition "A label or alias of the Wikidata item matched to the village."@en .

vd:origin-alt a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "alternative name"@en ;
  skos:definition "An alternative or historical name. Often points to a successor village or a building."@en .

vd:origin-stem a skos:Concept ;
  skos:inScheme vd:NameOrigins ;
  skos:prefLabel "name without Oud-/Nieuw-"@en ;
  skos:definition "A name without a leading \"Oud-\" or \"Nieuw-\". Only counts with drowning context or in a structured place field."@en .

#################################################################
# Statuses and reasons
#################################################################

vd:Statuses a skos:ConceptScheme ;
  skos:prefLabel "Candidate statuses"@en .

vd:status-accepted a skos:Concept ;
  skos:inScheme vd:Statuses ;
  skos:prefLabel "accepted"@en ;
  skos:definition "Selected automatically or by an override. Only accepted candidates go into combined.ttl."@en .

vd:status-review a skos:Concept ;
  skos:inScheme vd:Statuses ;
  skos:prefLabel "review"@en ;
  skos:definition "Plausible, but needs checking by hand."@en .

vd:status-rejected a skos:Concept ;
  skos:inScheme vd:Statuses ;
  skos:prefLabel "rejected"@en ;
  skos:definition "Ruled out."@en .

vd:StatusReasons a skos:ConceptScheme ;
  skos:prefLabel "Status reasons"@en .

vd:reason-location a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "location"@en ;
  skos:definition "Rejected: too far from the backbone point, or in another municipality or country."@en .

vd:reason-class a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "class"@en ;
  skos:definition "Rejected: the record's type is never the village, such as a municipality or a disambiguation page."@en .

vd:reason-date a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "date"@en ;
  skos:definition "Rejected: the record's date rules the village out."@en .

vd:reason-better-match a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "better match"@en ;
  skos:definition "Rejected: a stronger candidate was accepted for the same village or record."@en .

vd:reason-override a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "override"@en ;
  skos:definition "Accepted or rejected by a manual decision (see vd:overrideNote)."@en .

vd:reason-tie a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "tie"@en ;
  skos:definition "Review: equally strong candidates for different villages or records."@en .

vd:reason-homonym a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "homonym"@en ;
  skos:definition "Review: the matched name is also the name of a present-day place."@en .

vd:reason-weak-key a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "weak key"@en ;
  skos:definition "Review: matched by location only or by a name in text without context."@en .

vd:reason-spelling a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "spelling"@en ;
  skos:definition "Review: the names are spelled almost, but not quite, the same (see vd:editDistance)."@en .

vd:reason-alt-name a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "alternative name"@en ;
  skos:definition "Review: only an alternative name matched, and the record is not a historical place."@en .

vd:reason-no-coordinates a skos:Concept ;
  skos:inScheme vd:StatusReasons ;
  skos:prefLabel "no coordinates"@en ;
  skos:definition "Review: the name matches, but the record has no coordinates to check the location."@en .

vd:VillageStatuses a skos:ConceptScheme ;
  skos:prefLabel "Village match statuses"@en ;
  skos:definition "The overall result of matching a village against a source with at most one record per village."@en .

vd:village-matched a skos:Concept ;
  skos:inScheme vd:VillageStatuses ;
  skos:prefLabel "matched"@en ;
  skos:definition "Exactly one candidate was accepted."@en .

vd:village-ambiguous a skos:Concept ;
  skos:inScheme vd:VillageStatuses ;
  skos:prefLabel "ambiguous"@en ;
  skos:definition "Equally strong candidates tie, or more than one was accepted."@en .

vd:village-unconfirmed a skos:Concept ;
  skos:inScheme vd:VillageStatuses ;
  skos:prefLabel "unconfirmed"@en ;
  skos:definition "There are candidates, but none was accepted."@en .

vd:village-not-found a skos:Concept ;
  skos:inScheme vd:VillageStatuses ;
  skos:prefLabel "not found"@en ;
  skos:definition "No candidates."@en .

#################################################################
# Causes of drowning
#################################################################

vd:DrowningCauses a skos:ConceptScheme ;
  skos:prefLabel "Causes of drowning"@en , "Oorzaken van verdrinking"@nl .

vd:cause-military-inundation a skos:Concept ;
  skos:inScheme vd:DrowningCauses ;
  skos:prefLabel "military inundation"@en , "militaire inundatie"@nl ;
  skos:definition "Deliberately flooded for defence, for example during the Eighty Years' War."@en .

vd:cause-inundation a skos:Concept ;
  skos:inScheme vd:DrowningCauses ;
  skos:prefLabel "inundation"@en , "inundatie"@nl ;
  skos:definition "Deliberately flooded."@en .

vd:cause-storm-surge a skos:Concept ;
  skos:inScheme vd:DrowningCauses ;
  skos:prefLabel "storm surge"@en , "stormvloed"@nl .

vd:cause-outside-dikes a skos:Concept ;
  skos:inScheme vd:DrowningCauses ;
  skos:prefLabel "left outside the dikes"@en , "buitengedijkt"@nl ;
  skos:definition "Given up to the sea by building a new dike behind it."@en .

vd:cause-abandoned a skos:Concept ;
  skos:inScheme vd:DrowningCauses ;
  skos:prefLabel "abandoned"@en , "verlaten"@nl .
