# Wikidata items carrying a Rijksmonument ID (P359), with water-history context.
# #VALUES# is replaced by a batch of monument numbers from the RCE query.
SELECT ?item ?rm ?itemLabel ?inception ?architectLabel ?architect ?commissionerLabel ?commissioner
       ?ownerLabel ?owner ?operatorLabel ?operator ?image ?article ?namedAfter ?namedAfterLabel WHERE {
  VALUES ?rm { #VALUES# }
  ?item wdt:P359 ?rm .
  OPTIONAL { ?item wdt:P571 ?inception }
  OPTIONAL { ?item wdt:P84 ?architect }
  OPTIONAL { ?item wdt:P88 ?commissioner }
  OPTIONAL { ?item wdt:P127 ?owner }
  OPTIONAL { ?item wdt:P137 ?operator }
  OPTIONAL { ?item wdt:P18 ?image }
  OPTIONAL { ?item wdt:P138 ?namedAfter }
  OPTIONAL { ?article schema:about ?item ; schema:isPartOf <https://nl.wikipedia.org/> }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en". }
}
