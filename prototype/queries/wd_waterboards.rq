# All Dutch water boards (Q702081) on Wikidata with founding/dissolution dates,
# location and the "replaced by" (P1366) genealogy edges.
SELECT ?ws ?wsLabel ?inception ?dissolved ?coord ?replacedBy ?adminLabel WHERE {
  ?ws wdt:P31 wd:Q702081 .
  OPTIONAL { ?ws wdt:P571 ?inception }
  OPTIONAL { ?ws wdt:P576 ?dissolved }
  OPTIONAL { ?ws wdt:P625 ?coord }
  OPTIONAL { ?ws wdt:P1366 ?replacedBy . ?replacedBy wdt:P31 wd:Q702081 }
  OPTIONAL { ?ws wdt:P131 ?admin }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "nl,en". }
}
